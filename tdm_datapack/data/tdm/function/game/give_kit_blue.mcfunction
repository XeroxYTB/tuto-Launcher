# Kit PvP - Équipe Bleue
clear @s

# Armure cuir bleue (équipée)
item replace entity @s armor.head with leather_helmet[dyed_color=21759,unbreakable={}]
item replace entity @s armor.chest with leather_chestplate[dyed_color=21759,unbreakable={}]
item replace entity @s armor.legs with leather_leggings[dyed_color=21759,unbreakable={}]
item replace entity @s armor.feet with leather_boots[dyed_color=21759,unbreakable={}]

# Armes et items
item replace entity @s hotbar.0 with iron_sword[unbreakable={}]
item replace entity @s hotbar.1 with bow[unbreakable={}]
item replace entity @s hotbar.2 with golden_apple 3
item replace entity @s hotbar.3 with cooked_beef 16
item replace entity @s hotbar.8 with arrow 32
